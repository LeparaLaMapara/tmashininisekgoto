# ============================================================
# Thabang Neural Observatory — environment variables
# ============================================================

# --- Gemini (chat + embeddings) ---
# Read by @ai-sdk/google for both streamText and embeddings.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# Same value; used by @google/genai in Phase 2 node scripts (video/PDF ingestion).
GEMINI_API_KEY=your-gemini-api-key

# --- Supabase (site DB; may differ from the KB project) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- KB project (where the RAG tables live). Defaults baked into lib/rag/db.ts
# to zbdsqvpxpsygbuqnuekm + its public anon key; override here to relocate. ---
# KB_SUPABASE_URL=https://zbdsqvpxpsygbuqnuekm.supabase.co
# KB_SUPABASE_ANON_KEY=sb_publishable_...

# --- RAG ---
# Retrieval is ON by default. Set to false as a kill-switch to fall back to the
# static knowledge base.
# RAG_ENABLED=false
# Tenancy slug stamped on every KB row and used as match_kb_chunks filter_app.
RAG_APP_SLUG=tmashininisekgoto
# Shared secret guarding POST /api/admin/* (reindex, upload). Required.
ADMIN_TOKEN=generate-a-long-random-string

# --- Syndication (scripts/syndicate.mjs) ---
# Only needed to push cross-posts. Without them the script runs and reports what
# it would do, which is also what CI does on a pull request.
#
# dev.to: Settings -> Extensions -> DEV Community API Keys -> Generate API Key
DEVTO_API_KEY=
# Hashnode: hashnode.com/settings/developer -> Generate new token. It is a UUID.
# Note that Hashnode moved the API behind its Pro plan on 13 May 2026, for reads
# as well as writes, and that the endpoint is now gql-beta.hashnode.com:
# gql.hashnode.com 301s to an announcement page, which silently turns a POST
# into a GET.
HASHNODE_TOKEN=
# Hashnode publication id, a 24-character hex string, not a UUID. You need to
# have created a blog first. Read it from your dashboard URL, or query
# `{ me { publications(first: 1) { edges { node { id } } } } }`.
HASHNODE_PUBLICATION_ID=
